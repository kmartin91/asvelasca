{
  "name": "velasca",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Official Website of AS Velasca",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,jsx,scss}\"",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kmartin91/asvelasca.git"
  },
  "author": "Kevin Martin",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kmartin91/asvelasca/issues"
  },
  "homepage": "https://github.com/kmartin91/asvelasca#readme",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.2.8",
    "dompurify": "^3.4.17",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "sass-embedded": "^1.105.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.scss": [
      "prettier --write"
    ]
  },
  "browserslist": "> 0.5%, last 2 versions, not dead"
}
